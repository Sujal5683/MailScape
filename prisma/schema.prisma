generator client {
  provider = "prisma-client-js"
}

generator client_py {
  provider = "prisma-client-py"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  supabaseId             String?                 @unique
  email                  String                  @unique
  name                   String?
  avatarUrl              String?
  autoSyncInterval       String                  @default("15m") // "instantly"|"5m"|"15m"|"30m"|"1h"|"2h"|"6h"|"daily"
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               AccountConnection[]
  assistantConversations AssistantConversation[]
  auditEvents            AuditEvent[]
  pushSubscriptions      PushSubscription[]
}

model AccountConnection {
  id                String                   @id @default(cuid())
  userId            String
  provider          String                   @default("google")
  providerAccountId String
  emailAddress      String
  displayName       String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  status            String                   @default("active")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItems       ActionItem[]
  assistantActions  AssistantAction[]
  assistantConvs    AssistantConversation[]
  auditEvents       AuditEvent[]
  categories        Category[]
  deadlines         Deadline[]
  emails            Email[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  rules             Rule[]
  senders           Sender[]
  syncState         SyncState?
  threads           Thread[]

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model SyncState {
  id             String            @id @default(cuid())
  accountId      String            @unique
  gmailHistoryId String?
  lastSyncedAt   DateTime?
  syncStatus     String            @default("idle")
  syncProgress   Int               @default(0)  // 0–100 percent complete
  syncTotal      Int               @default(0)  // total messages in current sync batch
  errorCode      String?
  errorMessage   String?
  retryCount     Int               @default(0)
  updatedAt      DateTime          @updatedAt
  account        AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Thread {
  id               String            @id @default(cuid())
  accountId        String
  providerThreadId String
  subject          String?
  lastMessageAt    DateTime?
  conversationId   String?
  createdAt        DateTime          @default(now())
  emails           Email[]
  account          AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation     Conversation?     @relation(fields: [conversationId], references: [id])

  @@unique([accountId, providerThreadId])
  @@index([accountId, lastMessageAt])
  @@index([conversationId])
}

model Sender {
  id           String            @id @default(cuid())
  accountId    String
  senderEmail  String
  senderName   String?
  domain       String?
  firstSeenAt  DateTime?
  lastSeenAt   DateTime?
  messageCount Int               @default(0)
  discovered   Boolean           @default(true)
  ruleStatus   String            @default("none")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  emails       Email[]
  account      AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, senderEmail])
  @@index([accountId, lastSeenAt])
}

model Category {
  id                String                   @id @default(cuid())
  accountId         String
  name              String
  description       String?
  systemDefault     Boolean                  @default(false)
  sortOrder         Int                      @default(0)
  color             String                   @default("slate")
  icon              String                   @default("folder")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  account           AccountConnection        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  memberships       CategoryMembership[]
  deadlines         Deadline[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]

  @@unique([accountId, name])
}

model Email {
  id                       String                 @id @default(cuid())
  accountId                String
  threadId                 String?
  providerMessageId        String
  providerThreadId         String?
  senderId                 String?
  fromName                 String?
  fromEmail                String
  toRecipients             String                 @default("[]")
  ccRecipients             String                 @default("[]")
  bccRecipients            String                 @default("[]")
  subject                  String?
  snippet                  String?
  bodyText                 String?
  bodyHtmlSanitized        String?
  receivedAt               DateTime?
  isRead                   Boolean                @default(false)
  isStarred                Boolean                @default(false)
  isImportant              Boolean                @default(false)
  isSpam                   Boolean                @default(false)
  isDraft                  Boolean                @default(false)
  isSent                   Boolean                @default(false)
  isArchived               Boolean                @default(false)
  hasAttachment            Boolean                @default(false)
  snoozedUntil             DateTime?
  labels                   String                 @default("[]")
  extractedLinks           String                 @default("[]")
  classificationSource     String?
  classificationConfidence Float?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  actionItems              ActionItem[]
  memberships              CategoryMembership[]
  classifications          ClassificationResult[]
  deadlines                Deadline[]
  account                  AccountConnection      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sender                   Sender?                @relation(fields: [senderId], references: [id])
  thread                   Thread?                @relation(fields: [threadId], references: [id])
  attachments              EmailAttachment[]
  notifications            Notification[]

  @@unique([accountId, providerMessageId])
  @@index([accountId, receivedAt])
  @@index([accountId, isRead])
  @@index([accountId, senderId])
  @@index([accountId, snoozedUntil])
}

model EmailAttachment {
  id                   String  @id @default(cuid())
  emailId              String
  providerAttachmentId String
  filename             String
  mimeType             String
  size                 Int
  previewable          Boolean @default(false)
  email                Email   @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model CategoryMembership {
  id         String   @id @default(cuid())
  emailId    String
  categoryId String
  source     String
  confidence Float?
  assignedAt DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  email      Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model ClassificationResult {
  id               String   @id @default(cuid())
  emailId          String
  source           String
  categoryId       String?
  confidence       Float?
  rationaleSummary String?
  createdAt        DateTime @default(now())
  email            Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model Rule {
  id         String            @id @default(cuid())
  accountId  String
  name       String
  expression String
  actions    String
  priority   Int               @default(100)
  enabled    Boolean           @default(true)
  createdBy  String            @default("user")
  hitCount   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  account    AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions   RuleVersion[]

  @@index([accountId, priority])
}

model RuleVersion {
  id         String   @id @default(cuid())
  ruleId     String
  version    Int
  expression String
  actions    String
  createdAt  DateTime @default(now())
  rule       Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
}

model UserOverride {
  id           String   @id @default(cuid())
  accountId    String
  emailId      String?
  senderId     String?
  categoryId   String?
  overrideType String
  payload      String
  createdAt    DateTime @default(now())

  @@index([accountId])
}

model Deadline {
  id         String            @id @default(cuid())
  accountId  String
  emailId    String?
  categoryId String?
  title      String
  dueAt      DateTime?
  confidence Float?
  status     String            @default("open")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  account    AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id])
  email      Email?            @relation(fields: [emailId], references: [id])

  @@index([accountId, dueAt])
}

model ActionItem {
  id        String            @id @default(cuid())
  accountId String
  emailId   String?
  title     String
  status    String            @default("open")
  dueAt     DateTime?
  createdAt DateTime          @default(now())
  account   AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email     Email?            @relation(fields: [emailId], references: [id])

  @@index([accountId, status])
}

model Notification {
  id         String            @id @default(cuid())
  accountId  String
  emailId    String?
  categoryId String?
  title      String
  body       String?
  importance String            @default("normal")
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())
  account    AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id])
  email      Email?            @relation(fields: [emailId], references: [id])

  @@index([accountId, createdAt])
  @@index([accountId, isRead])
}

model NotificationPreference {
  id         String            @id @default(cuid())
  accountId  String
  channel    String
  categoryId String?
  enabled    Boolean           @default(true)
  account    AccountConnection @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([accountId, channel, categoryId])
}

model AssistantConversation {
  id        String             @id @default(cuid())
  userId    String
  accountId String?
  title     String?
  mode      String             @default("direct")
  archived  Boolean            @default(false)
  createdAt DateTime           @default(now())
  expiresAt DateTime?
  actions   AssistantAction[]
  account   AccountConnection? @relation(fields: [accountId], references: [id])
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]

  @@index([userId, createdAt])
  @@index([userId, archived])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           String
  contentJson    String
  attachments    String                @default("[]")
  sources        String                @default("[]")
  createdAt      DateTime              @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AssistantAction {
  id             String                @id @default(cuid())
  conversationId String
  userId         String
  accountId      String?
  toolName       String
  inputSummary   String
  resultSummary  String?
  reversible     Boolean               @default(false)
  inversePayload String?
  status         String
  errorMessage   String?
  createdAt      DateTime              @default(now())
  revertedAt     DateTime?
  account        AccountConnection?    @relation(fields: [accountId], references: [id])
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AuditEvent {
  id            String             @id @default(cuid())
  userId        String?
  accountId     String?
  eventType     String
  targetType    String?
  targetId      String?
  sourceSurface String?
  actionId      String?
  metadata      String             @default("{}")
  createdAt     DateTime           @default(now())
  account       AccountConnection? @relation(fields: [accountId], references: [id])
  user          User?              @relation(fields: [userId], references: [id])

  @@index([accountId, createdAt])
  @@index([eventType])
}

model Draft {
  id           String   @id @default(cuid())
  accountId    String
  toRecipients String   @default("[]")
  ccRecipients String   @default("[]")
  subject      String?
  body         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId, updatedAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  accountId String
  name      String
  filters   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

/// VAPID Web Push subscription — one per browser/device per user.
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  accountId String
  name      String
  subject   String
  body      String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model Conversation {
  id                 String                 @id @default(cuid())
  accountId          String
  canonicalSubject   String
  status             String                 @default("active")
  followUpState      String                 @default("none")
  importance         String                 @default("normal")
  messageCount       Int                    @default(0)
  participantSummary String                 @default("[]")
  latestMessageAt    DateTime?
  firstMessageAt     DateTime?
  aiSummary          String?
  aiSummaryAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  overrides          ConversationOverride[]
  threads            Thread[]

  @@index([accountId, latestMessageAt])
  @@index([accountId, status])
}

model EmailRelationship {
  id               String   @id @default(cuid())
  accountId        String
  fromEmailId      String
  toEmailId        String
  relationshipType String
  confidence       Float    @default(1.0)
  reason           String   @default("")
  createdAt        DateTime @default(now())

  @@index([accountId, fromEmailId])
  @@index([accountId, toEmailId])
}

model ConversationOverride {
  id             String       @id @default(cuid())
  accountId      String
  conversationId String
  emailId        String?
  threadId       String?
  overrideType   String
  payload        String       @default("{}")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([accountId, conversationId])
}

/// A saved scan configuration (reusable filter preset for Gmail ingestion).
model ScanConfiguration {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  description String?
  /// JSON: { scope, dateRange, senderFilter, subjectFilter, labelFilter, ... }
  config      String
  /// cron expression or "manual" or "incremental"
  schedule    String   @default("manual")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

/// A single scan job execution (manual or scheduled).
model ScanJob {
  id              String    @id @default(cuid())
  accountId       String
  configurationId String?
  /// manual | scheduled | incremental_sync | retry | initial_import
  jobType         String    @default("manual")
  /// queued | scanning | importing | classifying | completed | failed | cancelled | paused
  status          String    @default("queued")
  /// JSON: the full scan config snapshot at job creation time
  config          String
  /// JSON: { discovered, imported, updated, duplicates, failed, classified }
  results         String    @default("{}")
  /// JSON: { current, total, phase }
  progress        String    @default("{}")
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([accountId, createdAt])
  @@index([status])
}
